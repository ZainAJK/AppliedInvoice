@page "/invoice"
@rendermode InteractiveServer

@using AppliedInvoice.Services
@inject SQLiteService DB

<div class="container-fluid px-4 py-4">

    <!-- HEADER -->
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">Invoice Entry</h2>
        <p class="text-muted mb-0">Professional Invoice Management System</p>
    </div>

    <EditForm Model="invoice">

        <!-- MASTER -->
        <div class="card shadow border-0 mb-4">

            <div class="card-header bg-primary text-white">
                <h5 class="mb-0 fw-semibold">Invoice Detail</h5>
            </div>

            <div class="card-body bg-light">

                <div class="row g-3">

 
                    <div class="col-md-4">
                        <div class="form-floating">
                            <InputText class="form-control border-primary" id="invoiceType"
                                       @bind-Value="invoice.invoiceType" />
                            <label>Invoice Type</label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <InputDate class="form-control border-primary" id="invoiceDate"
                                       @bind-Value="invoice.invoiceDate" />
                            <label>Invoice Date</label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <InputText class="form-control border-primary" id="invoiceRefNo"
                                       @bind-Value="invoice.invoiceRefNo" />
                            <label>Invoice Ref No</label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <InputText class="form-control border-primary" id="scenarioId"
                                       @bind-Value="invoice.scenarioId" />
                            <label>Scenario Id</label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <InputText class="form-control border-primary" id="sellerNTNCNIC"
                                       @bind-Value="invoice.sellerNTNCNIC" />
                            <label>Seller NTN/CNIC</label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <InputText class="form-control border-primary" id="sellerBusinessName"
                                       @bind-Value="invoice.sellerBusinessName" />
                            <label>Seller Business Name</label>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-floating">
                            <InputText class="form-control border-primary" id="sellerProvince"
                                       @bind-Value="invoice.sellerProvince" />
                            <label>Seller Province</label>
                        </div>
                    </div>

                    <div class="col-md-8">
                        <div class="form-floating">
                            <InputText class="form-control border-primary" id="sellerAddress"
                                       @bind-Value="invoice.sellerAddress" />
                            <label>Seller Address</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputText class="form-control border-primary" id="buyerNTNCNIC"
                                       @bind-Value="invoice.buyerNTNCNIC" />
                            <label>Buyer NTN/CNIC</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputText class="form-control border-primary" id="buyerBusinessName"
                                       @bind-Value="invoice.buyerBusinessName" />
                            <label>Buyer Business Name</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputText class="form-control border-primary" id="buyerProvince"
                                       @bind-Value="invoice.buyerProvince" />
                            <label>Buyer Province</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputText class="form-control border-primary" id="buyerRegisterationType"
                                       @bind-Value="invoice.buyerRegisterationType" />
                            <label>Registration Type</label>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="form-floating">
                            <InputText class="form-control border-primary" id="buyerAddress"
                                       @bind-Value="invoice.buyerAddress" />
                            <label>Buyer Address</label>
                        </div>
                    </div>

                </div>

            </div>
        </div>

    </EditForm>

    <!-- ITEM -->
    <div class="container">

        <div class="card shadow-lg border-0 mb-4">

            <!-- HEADER -->
            <div class="card-header bg-gradient bg-success text-white py-3">
                <h5 class="mb-0 fw-bold">
                    Item Details
                </h5>
            </div>

            <div class="card-body bg-light">

                <!-- ROW 1 -->
                <div class="row g-3">

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputText class="form-control border-success shadow-sm"
                                       id="hsCode"
                                       @bind-Value="currentItem.hsCode" />
                            <label for="hsCode">HS Code</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputText class="form-control border-success shadow-sm"
                                       id="productDescription"
                                       @bind-Value="currentItem.productDescription" />
                            <label for="productDescription">Product Description</label>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="rate"
                                         @bind-Value="currentItem.rate"
                                         @oninput="CalculateCurrentItem" />
                            <label for="rate">Rate</label>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-floating">
                            <InputText class="form-control border-success shadow-sm"
                                       id="uom"
                                       @bind-Value="currentItem.uoM" />
                            <label for="uom">UOM</label>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="quantity"
                                         @bind-Value="currentItem.quantity"
                                         @oninput="CalculateCurrentItem" />
                            <label for="quantity">Quantity</label>
                        </div>
                    </div>

                </div>

                <!-- ROW 2 -->
                <div class="row g-3 mt-1">

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="valueExST"
                                         @bind-Value="currentItem.valueSalesExcludingsST" />
                            <label for="valueExST">Value Excluding ST</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="retailPrice"
                                         @bind-Value="currentItem.fixedNotifiedValueOrRetailPrice" />
                            <label for="retailPrice">Retail Price</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="salesTax"
                                         @bind-Value="currentItem.salesTaxApplicable"
                                         @oninput="CalculateCurrentItem" />
                            <label for="salesTax">Sales Tax</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="withholdingTax"
                                         @bind-Value="currentItem.salesTaxWithheldAtSource" />
                            <label for="withholdingTax">Withholding Tax</label>
                        </div>
                    </div>

                </div>

                <!-- ROW 3 -->
                <div class="row g-3 mt-1">

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="extraTax"
                                         @bind-Value="currentItem.extraTax" />
                            <label for="extraTax">Extra Tax</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="furtherTax"
                                         @bind-Value="currentItem.furtherTax" />
                            <label for="furtherTax">Further Tax</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="sroScheduleNo"
                                         @bind-Value="currentItem.sroScheduleNo" />
                            <label for="sroScheduleNo">SRO Schedule No</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="fedPayable"
                                         @bind-Value="currentItem.fedPayable" />
                            <label for="fedPayable">FED Payable</label>
                        </div>
                    </div>

                </div>

                <!-- ROW 4 -->
                <div class="row g-3 mt-1">

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="discount"
                                         @bind-Value="currentItem.discount"
                                         @oninput="CalculateCurrentItem" />
                            <label for="discount">Discount</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputText class="form-control border-success shadow-sm"
                                       id="saleType"
                                       @bind-Value="currentItem.saleType" />
                            <label for="saleType">Sale Type</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputText class="form-control border-success shadow-sm"
                                       id="sroItemSerialNo"
                                       @bind-Value="currentItem.sroItemSerialNo" />
                            <label for="sroItemSerialNo">SRO Item Serial No</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="total"
                                         @bind-Value="currentItem.totalValues" />
                            <label for="total">Total</label>
                        </div>
                    </div>

                </div>

                <!-- BUTTON -->
                <div class="row mt-4">
                    <div class="col-md-12 d-grid">
                        <button class="btn btn-success btn-lg fw-semibold shadow" @onclick="AddItem">
                            Add Item
                        </button>
                    </div>
                </div>

            </div>

        </div>

    </div>

    <!-- TABLE -->
    <div class="card shadow border-0 mb-4">

        <div class="card-header bg-info text-white">
            <h5 class="mb-0 fw-semibold">Items List</h5>
        </div>

        <div class="table-responsive">
            <table class="table table-hover text-center align-middle mb-0">

                <thead class="table-info">
                    <tr>
                        <th>Description</th>
                        <th>Rate</th>
                        <th>Qty</th>
                        <th>Tax</th>
                        <th>Total</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @for (int i = 0; i < invoice.items.Count; i++)
                    {
                        <tr>
                            <td>@invoice.items[i].productDescription</td>
                            <td>@invoice.items[i].rate</td>
                            <td>@invoice.items[i].quantity</td>
                            <td>@invoice.items[i].salesTaxApplicable</td>
                            <td class="fw-bold text-success">@invoice.items[i].totalValues</td>
                            <td>
                                <button class="btn btn-danger btn-sm"
                                        @onclick="() => DeleteItem(i)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

    <!-- TOTAL -->
    <div class="card shadow border-0">

        <div class="card-body bg-light d-flex justify-content-between align-items-center">

            <h4 class="fw-bold text-primary mb-0">
                Grand Total:
                <span class="text-success ms-2">@GrandTotal()</span>
            </h4>

            <button class="btn btn-primary btn-lg px-4 shadow" @onclick="Save">
                💾 Save Invoice
            </button>

        </div>

    </div>

</div>