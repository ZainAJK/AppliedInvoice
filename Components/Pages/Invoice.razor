@page "/invoice"
@using AppliedInvoice.Models
@using AppliedInvoice.Services
@inject SQLiteService DB

<h2 class="title">Invoice Entry</h2>

<div class="invoice-container">

    <div class="section">

        <h3>Invoice Information</h3>

        <div class="grid">

            <div>
                <label>Invoice Type</label>
                <input @bind="invoice.invoiceType" />
            </div>

            <div>
                <label>Invoice Date</label>
                <input @bind="invoice.invoiceDate" />
            </div>

            <div>
                <label>Invoice Ref No</label>
                <input @bind="invoice.invoiceRefNo" />
            </div>

            <div>
                <label>Scenario Id</label>
                <input @bind="invoice.scenarioId" />
            </div>

        </div>

    </div>


    <div class="section">

        <h3>Seller Information</h3>

        <div class="grid">

            <div>
                <label>Seller NTN/CNIC</label>
                <input @bind="invoice.sellerNTNCNIC" />
            </div>

            <div>
                <label>Seller Business Name</label>
                <input @bind="invoice.sellerBusinessName" />
            </div>

            <div>
                <label>Seller Province</label>
                <input @bind="invoice.sellerProvince" />
            </div>

            <div>
                <label>Seller Address</label>
                <input @bind="invoice.sellerAddress" />
            </div>

        </div>

    </div>


    <div class="section">

        <h3>Buyer Information</h3>

        <div class="grid">

            <div>
                <label>Buyer NTN/CNIC</label>
                <input @bind="invoice.buyerNTNCNIC" />
            </div>

            <div>
                <label>Buyer Business Name</label>
                <input @bind="invoice.buyerBusinessName" />
            </div>

            <div>
                <label>Buyer Province</label>
                <input @bind="invoice.buyerProvince" />
            </div>

            <div class="card-body bg-light">

                <!-- ROW 1 -->
                <div class="row g-3">

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputText class="form-control border-success shadow-sm"
                                       id="hsCode"
                                       @bind-Value="currentItem.hsCode" />
                            <label for="hsCode">HS Code</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputText class="form-control border-success shadow-sm"
                                       id="productDescription"
                                       @bind-Value="currentItem.productDescription" />
                            <label for="productDescription">Product Description</label>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="rate"
                                         @bind-Value="currentItem.rate"
                                         @oninput="CalculateCurrentItem" />
                            <label for="rate">Rate</label>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-floating">
                            <InputText class="form-control border-success shadow-sm"
                                       id="uom"
                                       @bind-Value="currentItem.uoM" />
                            <label for="uom">UOM</label>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="quantity"
                                         @bind-Value="currentItem.quantity"
                                         @oninput="CalculateCurrentItem" />
                            <label for="quantity">Quantity</label>
                        </div>
                    </div>

                </div>

                <!-- ROW 2 -->
                <div class="row g-3 mt-1">

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="valueExST"
                                         @bind-Value="currentItem.valueSalesExcludingST" />
                            <label for="valueExST">Value Excluding ST</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="retailPrice"
                                         @bind-Value="currentItem.fixedNotifiedValueOrRetailPrice" />
                            <label for="retailPrice">Retail Price</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="salesTax"
                                         @bind-Value="currentItem.salesTaxApplicable"
                                         @oninput="CalculateCurrentItem" />
                            <label for="salesTax">Sales Tax</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="withholdingTax"
                                         @bind-Value="currentItem.salesTaxWithheldAtSource" />
                            <label for="withholdingTax">Withholding Tax</label>
                        </div>
                    </div>

                </div>

                <!-- ROW 3 -->
                <div class="row g-3 mt-1">

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="extraTax"
                                         @bind-Value="currentItem.extraTax" />
                            <label for="extraTax">Extra Tax</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="furtherTax"
                                         @bind-Value="currentItem.furtherTax" />
                            <label for="furtherTax">Further Tax</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="sroScheduleNo"
                                         @bind-Value="currentItem.sroScheduleNo" />
                            <label for="sroScheduleNo">SRO Schedule No</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="fedPayable"
                                         @bind-Value="currentItem.fedPayable" />
                            <label for="fedPayable">FED Payable</label>
                        </div>
                    </div>

                </div>

                <!-- ROW 4 -->
                <div class="row g-3 mt-1">

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="discount"
                                         @bind-Value="currentItem.discount"
                                         @oninput="CalculateCurrentItem" />
                            <label for="discount">Discount</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputText class="form-control border-success shadow-sm"
                                       id="saleType"
                                       @bind-Value="currentItem.saleType" />
                            <label for="saleType">Sale Type</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputText class="form-control border-success shadow-sm"
                                       id="sroItemSerialNo"
                                       @bind-Value="currentItem.sroItemSerialNo" />
                            <label for="sroItemSerialNo">SRO Item Serial No</label>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-floating">
                            <InputNumber class="form-control border-success shadow-sm"
                                         id="total"
                                         @bind-Value="currentItem.totalValues" />
                            <label for="total">Total</label>
                        </div>
                    </div>

                </div>

                <!-- BUTTON -->
                <div class="row mt-4">
                    <div class="col-md-12 d-grid">
                        <button class="btn btn-success btn-lg fw-semibold shadow" @onclick="AddItem">
                            Add Item
                        </button>
                    </div>
                </div>

            <div>
                <label>Buyer Registration Type</label>
                <input @bind="invoice.buyerRegistrationType" />
            </div>

        </div>

    </div>


    <div class="section">

        <h3>Item Entry</h3>

        <div class="grid">

            <div>
                <label>hsCode</label>
                <input @bind="currentItem.hsCode" />
            </div>

            <div>
                <label>Description</label>
                <input @bind="currentItem.productDescription" />
            </div>

            <div>
                <label>Rate</label>
                <input type="number" @bind="currentItem.rate" @bind:event="oninput" />
            </div>

            <div>
                <label>UOM</label>
                <input @bind="currentItem.uoM" />
            </div>

            <div>
                <label>Quantity</label>
                <input type="number" @bind="currentItem.quantity" @bind:event="oninput" />
            </div>

            <div>
                <label>ValueExST</label>
                <input type="number" @bind="currentItem.valueSalesExcludingST" />
            </div>

            <div>
                <label>RetailPrice</label>
                <input type="number" @bind="currentItem.fixedNotifiedValueOrRetailPrice" />
            </div>

            <div>
                <label>SalesTax</label>
                <input type="number" @bind="currentItem.salesTaxApplicable" />
            </div>

            <div>
                <label>Withheld</label>
                <input type="number" @bind="currentItem.salesTaxWithheldAtSource" />
            </div>

            <div>
                <label>ExtraTax</label>
                <input type="number" @bind="currentItem.extraTax" />
            </div>

            <div>
                <label>FurtherTax</label>
                <input type="number" @bind="currentItem.furtherTax" />
            </div>

            <div>
                <label>SRO</label>
                <input type="number" @bind="currentItem.sroScheduleNo" />
            </div>

            <div>
                <label>FED</label>
                <input type="number" @bind="currentItem.fedPayable" />
            </div>

            <div>
                <label>Discount</label>
                <input type="number" @bind="currentItem.discount" />
            </div>

            <div>
                <label>SaleType</label>
                <input @bind="currentItem.saleType" />
            </div>

            <div>
                <label>SROItem</label>
                <input @bind="currentItem.sroItemSerialNo" />
            </div>

        </div>

        <button class="add-btn" @onclick="AddItem">
            + Add Item
        </button>

    </div>


    <div class="section">

        <h3>Items List</h3>

        <div class="table-wrapper">

            <table>

                <thead>
                    <tr>
                        <th>#</th>
                        <th>hsCode</th>
                        <th>Description</th>
                        <th>Rate</th>
                        <th>UOM</th>
                        <th>Qty</th>
                        <th>Total</th>
                        <th>ValueExST</th>
                        <th>RetailPrice</th>
                        <th>SalesTax</th>
                        <th>Withheld</th>
                        <th>Extra</th>
                        <th>Further</th>
                        <th>SRO</th>
                        <th>FED</th>
                        <th>Discount</th>
                        <th>SaleType</th>
                        <th>SROItem</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @for (int i = 0; i < invoice.items.Count; i++)
                    {
                        var item = invoice.items[i];

                        <tr>

                            <td>@(i + 1)</td>
                            <td>@item.hsCode</td>
                            <td>@item.productDescription</td>
                            <td>@item.rate</td>
                            <td>@item.uoM</td>
                            <td>@item.quantity</td>
                            <td>@item.totalValues</td>
                            <td>@item.valueSalesExcludingST</td>
                            <td>@item.fixedNotifiedValueOrRetailPrice</td>
                            <td>@item.salesTaxApplicable</td>
                            <td>@item.salesTaxWithheldAtSource</td>
                            <td>@item.extraTax</td>
                            <td>@item.furtherTax</td>
                            <td>@item.sroScheduleNo</td>
                            <td>@item.fedPayable</td>
                            <td>@item.discount</td>
                            <td>@item.saleType</td>
                            <td>@item.sroItemSerialNo</td>

                            <td>
                                <button class="delete-btn" @onclick="(() => DeleteItem(i))">
                                    X
                                </button>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="grand-total">
            Grand Total : <b>@GrandTotal()</b>
        </div>

    </div>


    <div class="actions">

        <button class="save-btn" @onclick="SaveInvoice">
            Save Invoice
        </button>

        <button class="api-btn">
            Call API
        </button>

    </div>

</div>
</div>

<style>

    body {
        background: #eef2f7;
        font-family: Segoe UI,Arial;
    }

    .title {
        text-align: center;
        margin-bottom: 20px;
    }

    .invoice-container {
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    .section {
        margin-bottom: 25px;
    }

        .section h3 {
            border-left: 5px solid #2563eb;
            padding-left: 10px;
        }

    .grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 15px;
    }

    label {
        font-size: 12px;
        font-weight: 600;
    }

    input {
        width: 100%;
        padding: 8px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
    }

        table th {
            background: #1d4ed8;
            color: white;
            padding: 10px;
            position: sticky;
            top: 0;
        }

        table td {
            border: 1px solid #e5e7eb;
            padding: 6px;
        }

    .add-btn {
        margin-top: 10px;
        background: #16a34a;
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 6px;
    }

    .delete-btn {
        background: #ef4444;
        color: white;
        border: none;
        padding: 5px 8px;
        border-radius: 4px;
    }

    .grand-total {
        margin-top: 15px;
        font-size: 20px;
        font-weight: bold;
    }

    .actions {
        margin-top: 25px;
    }

    .save-btn {
        background: #f59e0b;
        color: white;
        border: none;
        padding: 12px 22px;
        border-radius: 6px;
        margin-right: 10px;
    }

    .api-btn {
        background: #2563eb;
        color: white;
        border: none;
        padding: 12px 22px;
        border-radius: 6px;
    }

</style>

