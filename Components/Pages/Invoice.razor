@page "/invoice"
@using AppliedInvoice.Models

<h2 class="title">Invoice Entry</h2>

<div class="invoice-container">

    <div class="section">

        <h3>Invoice Information</h3>

        <div class="grid">

            <div>
                <label>Invoice Type</label>
                <input @bind="invoice.invoiceType" />
            </div>

            <div>
                <label>Invoice Date</label>
                <input type="date" @bind="invoice.invoiceDate" />
            </div>

            <div>
                <label>Invoice Ref No</label>
                <input @bind="invoice.invoiceRefNo" />
            </div>

            <div>
                <label>Scenario Id</label>
                <input @bind="invoice.scenarioId" />
            </div>

        </div>

    </div>


    <div class="section">

        <h3>Seller Information</h3>

        <div class="grid">

            <div>
                <label>Seller NTN/CNIC</label>
                <input @bind="invoice.sellerNTNCNIC" />
            </div>

            <div>
                <label>Seller Business Name</label>
                <input @bind="invoice.sellerBusinessName" />
            </div>

            <div>
                <label>Seller Province</label>
                <input @bind="invoice.sellerProvince" />
            </div>

            <div>
                <label>Seller Address</label>
                <input @bind="invoice.sellerAddress" />
            </div>

        </div>

    </div>


    <div class="section">

        <h3>Buyer Information</h3>

        <div class="grid">

            <div>
                <label>Buyer NTN/CNIC</label>
                <input @bind="invoice.buyerNTNCNIC" />
            </div>

            <div>
                <label>Buyer Business Name</label>
                <input @bind="invoice.buyerBusinessName" />
            </div>

            <div>
                <label>Buyer Province</label>
                <input @bind="invoice.buyerProvince" />
            </div>

            <div>
                <label>Buyer Address</label>
                <input @bind="invoice.buyerAddress" />
            </div>

            <div>
                <label>Buyer Registration Type</label>
                <input @bind="invoice.buyerRegisterationType" />
            </div>

        </div>

    </div>


    <div class="section">

        <h3>Item Entry</h3>

        <div class="grid">

            <div>
                <label>hsCode</label>
                <input @bind="currentItem.hsCode" />
            </div>

            <div>
                <label>Description</label>
                <input @bind="currentItem.productDescription" />
            </div>

            <div>
                <label>Rate</label>
                <<input type="number" @bind="currentItem.rate" @bind:event="oninput" />
            </div>

            <div>
                <label>UOM</label>
                <input @bind="currentItem.uoM" />
            </div>

            <div>
                <label>Quantity</label>
                <input type="number" @bind="currentItem.quantity" @bind:event="oninput" />
            </div>

            <div>
                <label>ValueExST</label>
                <input type="number" @bind="currentItem.valueSalesExcludingsST" />
            </div>

            <div>
                <label>RetailPrice</label>
                <input type="number" @bind="currentItem.fixedNotifiedValueOrRetailPrice" />
            </div>

            <div>
                <label>SalesTax</label>
                <input type="number" @bind="currentItem.salesTaxApplicable" />
            </div>

            <div>
                <label>Withheld</label>
                <input type="number" @bind="currentItem.salesTaxWithheldAtSource" />
            </div>

            <div>
                <label>ExtraTax</label>
                <input type="number" @bind="currentItem.extraTax" />
            </div>

            <div>
                <label>FurtherTax</label>
                <input type="number" @bind="currentItem.furtherTax" />
            </div>

            <div>
                <label>SRO</label>
                <input type="number" @bind="currentItem.sroScheduleNo" />
            </div>

            <div>
                <label>FED</label>
                <input type="number" @bind="currentItem.fedPayable" />
            </div>

            <div>
                <label>Discount</label>
                <input type="number" @bind="currentItem.discount" />
            </div>

            <div>
                <label>SaleType</label>
                <input @bind="currentItem.saleType" />
            </div>

            <div>
                <label>SROItem</label>
                <input @bind="currentItem.sroItemSerialNo" />
            </div>

        </div>

        <button class="add-btn" @onclick="AddItem">
            + Add Item
        </button>

    </div>


    <div class="section">

        <h3>Items List</h3>

        <div class="table-wrapper">

            <table>

                <thead>
                    <tr>
                        <th>#</th>
                        <th>hsCode</th>
                        <th>Description</th>
                        <th>Rate</th>
                        <th>UOM</th>
                        <th>Qty</th>
                        <th>Total</th>
                        <th>ValueExST</th>
                        <th>RetailPrice</th>
                        <th>SalesTax</th>
                        <th>Withheld</th>
                        <th>Extra</th>
                        <th>Further</th>
                        <th>SRO</th>
                        <th>FED</th>
                        <th>Discount</th>
                        <th>SaleType</th>
                        <th>SROItem</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @for (int i = 0; i < invoice.items.Count; i++)
                    {
                        var item = invoice.items[i];

                        <tr>

                            <td>@(i + 1)</td>
                            <td>@item.hsCode</td>
                            <td>@item.productDescription</td>
                            <td>@item.rate</td>
                            <td>@item.uoM</td>
                            <td>@item.quantity</td>
                            <td>@item.totalValues</td>
                            <td>@item.valueSalesExcludingsST</td>
                            <td>@item.fixedNotifiedValueOrRetailPrice</td>
                            <td>@item.salesTaxApplicable</td>
                            <td>@item.salesTaxWithheldAtSource</td>
                            <td>@item.extraTax</td>
                            <td>@item.furtherTax</td>
                            <td>@item.sroScheduleNo</td>
                            <td>@item.fedPayable</td>
                            <td>@item.discount</td>
                            <td>@item.saleType</td>
                            <td>@item.sroItemSerialNo</td>

                            <td>
                                <button class="delete-btn" @onclick="(() => DeleteItem(i))">
                                    X
                                </button>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="grand-total">
            Grand Total : <b>@GrandTotal()</b>
        </div>

    </div>


    <div class="actions">

        <button class="save-btn" @onclick="SaveInvoice">
            Save Invoice
        </button>

        <button class="api-btn">
            Call API
        </button>

    </div>

</div>


<style>

    body {
        background: #eef2f7;
        font-family: Segoe UI,Arial;
    }

    .title {
        text-align: center;
        margin-bottom: 20px;
    }

    .invoice-container {
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    .section {
        margin-bottom: 25px;
    }

        .section h3 {
            border-left: 5px solid #2563eb;
            padding-left: 10px;
        }

    .grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 15px;
    }

    label {
        font-size: 12px;
        font-weight: 600;
    }

    input {
        width: 100%;
        padding: 8px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
    }

        table th {
            background: #1d4ed8;
            color: white;
            padding: 10px;
            position: sticky;
            top: 0;
        }

        table td {
            border: 1px solid #e5e7eb;
            padding: 6px;
        }

    .add-btn {
        margin-top: 10px;
        background: #16a34a;
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 6px;
    }

    .delete-btn {
        background: #ef4444;
        color: white;
        border: none;
        padding: 5px 8px;
        border-radius: 4px;
    }

    .grand-total {
        margin-top: 15px;
        font-size: 20px;
        font-weight: bold;
    }

    .actions {
        margin-top: 25px;
    }

    .save-btn {
        background: #f59e0b;
        color: white;
        border: none;
        padding: 12px 22px;
        border-radius: 6px;
        margin-right: 10px;
    }

    .api-btn {
        background: #2563eb;
        color: white;
        border: none;
        padding: 12px 22px;
        border-radius: 6px;
    }

</style>

@code {

    InvoiceMaster invoice = new InvoiceMaster()
    {
        items = new List<InvoiceDetails>()
    };

    InvoiceDetails currentItem = new InvoiceDetails();

    void AddItem()
    {
        if (currentItem.rate < 0) currentItem.rate = 0;
        if (currentItem.quantity < 0) currentItem.quantity = 0;

        currentItem.totalValues = currentItem.rate * currentItem.quantity;

        if (currentItem.valueSalesExcludingsST == 0)
            currentItem.valueSalesExcludingsST = currentItem.totalValues;

        if (currentItem.salesTaxApplicable == 0)
            currentItem.salesTaxApplicable = currentItem.totalValues * 0.18M;

        invoice.items.Add(currentItem);

        currentItem = new InvoiceDetails();

        StateHasChanged();
    }

    void SafeDefaults()
    {

        if (currentItem.rate < 0)
            currentItem.rate = 0;

        if (currentItem.quantity < 0)
            currentItem.quantity = 0;

        if (currentItem.valueSalesExcludingsST < 0)
            currentItem.valueSalesExcludingsST = 0;

        if (currentItem.salesTaxApplicable < 0)
            currentItem.salesTaxApplicable = 0;

        if (currentItem.extraTax < 0)
            currentItem.extraTax = 0;

        if (currentItem.furtherTax < 0)
            currentItem.furtherTax = 0;

        if (currentItem.fedPayable < 0)
            currentItem.fedPayable = 0;

        if (currentItem.discount < 0)
            currentItem.discount = 0;

    }


    void CalculateCurrentItem()
    {

        currentItem.totalValues = currentItem.rate * currentItem.quantity;

        if (currentItem.valueSalesExcludingsST == 0)
        {
            currentItem.valueSalesExcludingsST = currentItem.totalValues;
        }

        if (currentItem.salesTaxApplicable == 0)
        {
            currentItem.salesTaxApplicable = currentItem.valueSalesExcludingsST * 0.18M;
        }

    }


    void DeleteItem(int index)
    {
        invoice.items.RemoveAt(index);
    }


    decimal GrandTotal()
    {

        decimal total = 0;

        foreach (var item in invoice.items)
        {

            decimal itemTotal =
            item.totalValues
            + item.salesTaxApplicable
            + item.extraTax
            + item.furtherTax
            + item.fedPayable
            - item.discount;

            total += itemTotal;

        }

        return total;

    }


    void SaveInvoice()
    {
        Console.WriteLine("Invoice Saved");
    }

}