@page "/invoice"

<h2 class="text-center mb-4">Invoice Entry</h2>

<div class="container">

    <!-- ================= INVOICE MASTER ================= -->
    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white">
            Invoice Information
        </div>

        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-3 form-floating">
                    <input class="form-control" @bind="invoice.invoiceType" />
                    <label>Invoice Type</label>
                </div>

                <div class="col-md-3 form-floating">
                    <input type="date" class="form-control" @bind="invoice.invoiceDate" />
                    <label>Invoice Date</label>
                </div>

                <div class="col-md-3 form-floating">
                    <input class="form-control" @bind="invoice.invoiceRefNo" />
                    <label>Invoice Ref No</label>
                </div>

                <div class="col-md-3 form-floating">
                    <input class="form-control" @bind="invoice.scenarioId" />
                    <label>Scenario Id</label>
                </div>

                <!-- Seller -->
                <div class="col-md-4 form-floating">
                    <input class="form-control" @bind="invoice.sellerNTNCNIC" />
                    <label>Seller NTN/CNIC</label>
                </div>

                <div class="col-md-4 form-floating">
                    <input class="form-control" @bind="invoice.sellerBusinessName" />
                    <label>Seller Business Name</label>
                </div>

                <div class="col-md-4 form-floating">
                    <input class="form-control" @bind="invoice.sellerProvince" />
                    <label>Seller Province</label>
                </div>

                <div class="col-md-12 form-floating">
                    <input class="form-control" @bind="invoice.sellerAddress" />
                    <label>Seller Address</label>
                </div>

                <!-- Buyer -->
                <div class="col-md-3 form-floating">
                    <input class="form-control" @bind="invoice.buyerNTNCNIC" />
                    <label>Buyer NTN/CNIC</label>
                </div>

                <div class="col-md-3 form-floating">
                    <input class="form-control" @bind="invoice.buyerBusinessName" />
                    <label>Buyer Business Name</label>
                </div>

                <div class="col-md-3 form-floating">
                    <input class="form-control" @bind="invoice.buyerProvince" />
                    <label>Buyer Province</label>
                </div>

                <div class="col-md-3 form-floating">
                    <input class="form-control" @bind="invoice.buyerRegisterationType" />
                    <label>Buyer Registration Type</label>
                </div>

                <div class="col-md-12 form-floating">
                    <input class="form-control" @bind="invoice.buyerAddress" />
                    <label>Buyer Address</label>
                </div>

            </div>
        </div>
    </div>

    <!-- ================= ITEM DETAILS ================= -->
    <div class="card shadow mb-4">
        <div class="card-header bg-success text-white">
            Item Details
        </div>

        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-3 form-floating">
                    <input class="form-control" @bind="currentItem.hsCode" />
                    <label>HS Code</label>
                </div>

                <div class="col-md-3 form-floating">
                    <input class="form-control" @bind="currentItem.productDescription" />
                    <label>Product Description</label>
                </div>

                <div class="col-md-2 form-floating">
                    <input type="number" class="form-control"
                           @bind="currentItem.rate"
                           @oninput="CalculateCurrentItem" />
                    <label>Rate</label>
                </div>

                <div class="col-md-2 form-floating">
                    <input class="form-control" @bind="currentItem.uoM" />
                    <label>UOM</label>
                </div>

                <div class="col-md-2 form-floating">
                    <input type="number" class="form-control"
                           @bind="currentItem.quantity"
                           @oninput="CalculateCurrentItem" />
                    <label>Quantity</label>
                </div>

                <div class="col-md-3 form-floating">
                    <input type="number" class="form-control" @bind="currentItem.valueSalesExcludingsST" />
                    <label>Value Excluding ST</label>
                </div>

                <div class="col-md-3 form-floating">
                    <input type="number" class="form-control" @bind="currentItem.fixedNotifiedValueOrRetailPrice" />
                    <label>Retail Price</label>
                </div>

                <div class="col-md-3 form-floating">
                    <input type="number" class="form-control" @bind="currentItem.salesTaxApplicable" />
                    <label>Sales Tax</label>
                </div>

                <div class="col-md-3 form-floating">
                    <input type="number" class="form-control" @bind="currentItem.salesTaxWithheldAtSource" />
                    <label>Withholding Tax</label>
                </div>

                <div class="col-md-3 form-floating">
                    <input type="number" class="form-control" @bind="currentItem.extraTax" />
                    <label>Extra Tax</label>
                </div>

                <div class="col-md-3 form-floating">
                    <input type="number" class="form-control" @bind="currentItem.furtherTax" />
                    <label>Further Tax</label>
                </div>

                <div class="col-md-3 form-floating">
                    <input type="number" class="form-control" @bind="currentItem.sroScheduleNo" />
                    <label>SRO Schedule No</label>
                </div>

                <div class="col-md-3 form-floating">
                    <input type="number" class="form-control" @bind="currentItem.fedPayable" />
                    <label>FED Payable</label>
                </div>

                <div class="col-md-3 form-floating">
                    <input type="number" class="form-control"
                           @bind="currentItem.discount"
                           @oninput="CalculateCurrentItem" />
                    <label>Discount</label>
                </div>

                <div class="col-md-3 form-floating">
                    <input class="form-control" @bind="currentItem.saleType" />
                    <label>Sale Type</label>
                </div>

                <div class="col-md-3 form-floating">
                    <input class="form-control" @bind="currentItem.sroItemSerialNo" />
                    <label>SRO Item Serial No</label>
                </div>

                <div class="col-md-3 form-floating">
                    <input type="number" class="form-control" @bind="currentItem.totalValues" />
                    <label>Total</label>
                </div>

                <div class="col-md-12 d-grid mt-3">
                    <button class="btn btn-success btn-lg" @onclick="AddItem">
                        Add Item
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- ================= ITEMS TABLE ================= -->
    <div class="card shadow mb-4">
        <div class="card-header bg-dark text-white">
            Items List
        </div>

        <div class="card-body table-responsive">
            <table class="table table-bordered table-striped text-center align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Description</th>
                        <th>Rate</th>
                        <th>Qty</th>
                        <th>Tax</th>
                        <th>Total</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @for (int i = 0; i < invoice.items.Count; i++)
                    {
                        <tr>
                            <td>@invoice.items[i].productDescription</td>
                            <td>@invoice.items[i].rate</td>
                            <td>@invoice.items[i].quantity</td>
                            <td>@invoice.items[i].salesTaxApplicable</td>
                            <td>@invoice.items[i].totalValues</td>
                            <td>
                                <button class="btn btn-danger btn-sm"
                                        @onclick="() => DeleteItem(i)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

    <!-- ================= TOTAL ================= -->
    <div class="card shadow">
        <div class="card-body text-end">

            <h4>
                Grand Total:
                <span class="text-success">@GrandTotal()</span>
            </h4>

            <button class="btn btn-primary btn-lg mt-2" @onclick="Save">
                Save Invoice
            </button>

        </div>
    </div>

</div>